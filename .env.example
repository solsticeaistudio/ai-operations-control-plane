# Local development defaults. These are INSECURE on purpose so the demo is easy
# to run. For a customer deployment use .env.production.example (fail-closed):
#   AIOPS_ENV=production requires AIOPS_API_KEY, AIOPS_DEMO_MODE=false and
#   ALLOW_STORAGE_FALLBACK=false, or the app refuses to start. See SECURITY.md.
AIOPS_ENV=development

AIOPS_STORAGE=sqlite
AIOPS_SQLITE_PATH=./data/aiops.db
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=aiops
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# DANGEROUS default: silent fallback to SQLite if ClickHouse is unreachable.
ALLOW_STORAGE_FALLBACK=true

# DANGEROUS default: demo seeding is enabled.
AIOPS_DEMO_MODE=true

# DANGEROUS default: empty key means the /v1 product API is OPEN (no auth).
AIOPS_API_KEY=

OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
