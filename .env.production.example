# Customer / production deployment (fail-closed).
#
# Set AIOPS_ENV=production and the app will REFUSE TO START unless every
# dangerous development default below is overridden. See SECURITY.md.
AIOPS_ENV=production

# Required: the product API must not be open in production.
AIOPS_API_KEY=replace-with-a-long-random-secret

# Required: demo seeding must be off so it cannot inject fabricated data.
AIOPS_DEMO_MODE=false

# Required: no silent fallback to a different storage backend.
ALLOW_STORAGE_FALLBACK=false

# Storage: use a persistent, backed-up path (or a configured ClickHouse).
AIOPS_STORAGE=sqlite
AIOPS_SQLITE_PATH=/var/lib/aiops/aiops.db
# CLICKHOUSE_URL=http://clickhouse:8123
# CLICKHOUSE_DATABASE=aiops
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# Optional live provider calls.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
